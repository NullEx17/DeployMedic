{
  "name": "@deploymedic/cli",
  "version": "0.1.0",
  "description": "DeployMedic CLI — scan projects for deployment issues",
  "type": "module",
  "bin": {
    "deploymedic": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/bin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@deploymedic/core": "0.1.0",
    "commander": "^13.1.0",
    "ignore": "^7.0.14",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "license": "MIT",
  "author": "NullEx17",
  "homepage": "https://github.com/NullEx17/DeployMedic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NullEx17/DeployMedic.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/NullEx17/DeployMedic/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
